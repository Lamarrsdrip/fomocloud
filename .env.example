# ---------------------------------------------------------------------------
# MemeCloud v0.6 multi-user split deployment
# Hostinger = static frontend; Windows VPS = API/workers/data.
# Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MongoDB (Prisma Mongo requires a replica set for transactions).
DATABASE_URL=mongodb://localhost:27017/memecloud?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Auth / sessions / secret envelope. Generate long random production values.
AUTH_JWT_SECRET=replace-with-at-least-64-random-bytes
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_DAYS=30
ENVELOPE_ENCRYPTION_KEY=replace-with-64-hex-char-aes256-key
ADMIN_BOOTSTRAP_SECRET=replace-with-one-time-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-long-random-secret

# Trading remains simulation until a reviewed delegated/session signer is configured.
EXECUTION_MODE=simulation
LIVE_EXECUTION_ENABLED=false
SIGNER_PROVIDER=privy
# Privy server-side delegated/session wallet provider. These can also be entered encrypted in Admin -> signer.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# P-256 authorization key for the restricted additional signer. Prefer KMS/HSM/custom signer in mature production.
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_SIGNER_ID=
PRIVY_POLICY_ID=
PRIVY_SPONSOR_GAS=false
# LIVE still stays false until every user has an explicit limited delegated wallet permissionRef and owner controlled test passes.

# Solana raw data + executable quote path.
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_HTTP=
SOLANA_RPC_WS=
SOLANA_FALLBACK_RPC_HTTP=
SOLANA_COMMITMENT=confirmed
USDC_MINT_SOLANA=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_QUOTE_MINTS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD3s6bGx6qHnoXfWodumJGz,So11111111111111111111111111111111111111112
JUPITER_API_BASE=https://api.jup.ag
JUPITER_API_KEY=
MARKET_QUOTE_USD=10

# Optional enrichment / fallback providers.
HELIUS_API_KEY=
HELIUS_RPC_HTTP=
BIRDEYE_API_KEY=
# Discovery defaults. Worker will IDLE rather than fabricate candidates when Birdeye is not configured.
DISCOVERY_ENABLED=true
DISCOVERY_SCAN_INTERVAL_MS=60000
DISCOVERY_MIN_LIQUIDITY_USD=15000
DISCOVERY_MIN_MARKET_CAP_USD=50000
DISCOVERY_MAX_MARKET_CAP_USD=50000000
DISCOVERY_TOP_TOKENS=40
DISCOVERY_TOP_TRADERS_PER_TOKEN=40
DISCOVERY_PAPER_MIN_SCORE=70
DISCOVERY_PROVEN_MIN_SCORE=82
DISCOVERY_PROVEN_MIN_FORWARD_SAMPLES=15
DISCOVERY_PROVEN_MIN_FORWARD_MEAN_PCT=5
BIRDEYE_WS_URL=wss://public-api.birdeye.so/socket/solana
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_MODE=adaptive

# EVM/multi-chain adapter configuration. Do not mark a chain LIVE until implemented/tested.
ENABLED_CHAINS=SOLANA
ADAPTER_READY_CHAINS=BASE,ETHEREUM,BNB,ARBITRUM,AVALANCHE
DEFAULT_TRADING_CASH_ASSET=USDC
ZEROX_API_KEY=
ONEINCH_API_KEY=
EVM_RPC_BASE=
EVM_RPC_ETHEREUM=
EVM_RPC_BNB=
EVM_RPC_ARBITRUM=
EVM_RPC_AVALANCHE=

# X OAuth (account linking) + optional social intelligence bearer.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=http://localhost:4000/auth/x/callback
X_API_BEARER_TOKEN=

# SMTP fallback. Admin may store provider configuration encrypted instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MemeCloud <no-reply@example.com>

# Standards-based Web Push fallback. Admin can generate/store encrypted VAPID config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Fees disabled during test deployment.
PLATFORM_FEE_BPS=0

# Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

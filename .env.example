# ---------------------------------------------------------------------------
# FomoCloud production environment
# Never commit actual secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# MongoDB (Prisma). Local dev uses a single-node replica set (required by Prisma for Mongo).
# Production: a MongoDB Atlas mongodb+srv URL.
DATABASE_URL=mongodb://localhost:27017/fomocloud?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379

# Solana
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_HTTP=
SOLANA_RPC_WS=
SOLANA_FALLBACK_RPC_HTTP=
SOLANA_COMMITMENT=confirmed

# Market/execution provider
JUPITER_API_BASE=https://api.jup.ag
JUPITER_API_KEY=

# Security: live execution is deliberately OFF until configured and audited.
EXECUTION_MODE=simulation
LIVE_EXECUTION_ENABLED=false
SIGNER_PROVIDER=disabled
SIGNER_PROVIDER_API_KEY=
SIGNER_PROVIDER_WEBHOOK_SECRET=
SIGNER_PROVIDER_POLICY_ID=

# API auth / encryption
AUTH_JWT_SECRET=replace-with-64-byte-secret
ENVELOPE_ENCRYPTION_KEY=replace-with-kms-in-production
INTERNAL_SERVICE_TOKEN=replace-me

# Push / notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=


# Intelligence / market data
HELIUS_API_KEY=
HELIUS_RPC_HTTP=
BIRDEYE_API_KEY=
BIRDEYE_WS_URL=wss://public-api.birdeye.so/socket/solana
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_MODE=adaptive

# Social/X enrichment (optional; absence must not freeze the fast trading path)
X_API_BEARER_TOKEN=

# Fee model: no subscription; transparent execution fee. Set only after legal/product review.
PLATFORM_FEE_BPS=0


# Admin
ADMIN_API_TOKEN=replace-with-long-random-secret

# Multi-chain
ENABLED_CHAINS=SOLANA,BASE,ETHEREUM,BNB
DEFAULT_TRADING_CASH_ASSET=USDC
ZEROX_API_KEY=
ONEINCH_API_KEY=
EVM_RPC_BASE=
EVM_RPC_ETHEREUM=
EVM_RPC_BNB=
EVM_RPC_ARBITRUM=
EVM_RPC_AVALANCHE=

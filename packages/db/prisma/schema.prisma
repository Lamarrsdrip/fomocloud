generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Chain {
  SOLANA
  BASE
  ETHEREUM
  BNB
  ARBITRUM
  AVALANCHE
  SUI
  HYPERLIQUID
}

enum UserRole {
  USER
  OWNER
  ADMIN
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  VERIFIED
  COMMUNITY_VERIFIED
  UNVERIFIED
}

enum TraderKind {
  PLATFORM
  CUSTOM
}

enum FollowMode {
  FOLLOW_ONLY
  WATCH_ONLY
  AUTO_COPY
  PAUSED
}

enum SignalAction {
  BUY
  SELL
}

enum SignalStatus {
  DETECTED
  VALIDATING
  APPROVED
  SKIPPED
  EXECUTING
  COMPLETED
  FAILED
}

enum OrderStatus {
  QUOTED
  SIGNING
  SUBMITTED
  CONFIRMING
  CONFIRMED
  FAILED
}

enum PositionStatus {
  OPEN
  PARTIALLY_CLOSED
  CLOSED
  FAILED
}

enum ExecutionMode {
  SIMULATION
  LIVE
}

model User {
  id                    String                  @id @default(auto()) @map("_id") @db.ObjectId
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  email                 String?
  passwordHash          String?
  emailVerifiedAt       DateTime?
  displayName           String?
  username              String?
  avatarUrl             String?
  publicProfileEnabled  Boolean                 @default(false)
  role                  UserRole                @default(USER)
  status                AccountStatus           @default(ACTIVE)
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  wallets               Wallet[]
  walletAssetBalances   WalletAssetBalance[]
  deposits              Deposit[]
  ledgerEntries         LedgerEntry[]
  follows               UserFollow[]
  positions             Position[]
  orders                Order[]
  copyDecisions         CopyDecision[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  notificationPrefs     NotificationPreference?
  auditLogs             AuditLog[]
  cashAllocations       TradingCashAllocation[]
  tradingSettings       GlobalTradingSettings?
  refreshSessions       RefreshSession[]
  activityEvents        UserActivityEvent[]
  pnlSnapshots          PnLSnapshot[]
  linkedSocialAccounts  LinkedSocialAccount[]
  emailIdentity         EmailIdentity?
  userHandle            UserHandle?
  customTraders         Trader[]                @relation("CustomTraderOwner")
  followers             UserSocialFollow[]      @relation("FollowingUser")
  following             UserSocialFollow[]      @relation("FollowerUser")

  @@index([createdAt])
  @@index([role, status])
}

model EmailIdentity {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  userId          String @unique @db.ObjectId
  emailNormalized String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserHandle {
  id                 String @id @default(auto()) @map("_id") @db.ObjectId
  userId             String @unique @db.ObjectId
  usernameNormalized String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model VerificationToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
}

model WalletChallenge {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  chain      Chain
  address    String
  message    String
  purpose    String    @default("LOGIN")
  userId     String?   @db.ObjectId
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([chain, address, expiresAt])
}

model Wallet {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  userId           String               @db.ObjectId
  chain            Chain
  address          String
  label            String?
  custodyType      String?
  isPrimary        Boolean              @default(false)
  tradingEnabled   Boolean              @default(false)
  permissionRef    String?
  permissionExpiry DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetBalances    WalletAssetBalance[]
  deposits         Deposit[]
  syncState        WalletSyncState?

  @@unique([chain, address])
  @@index([userId])
}

enum DepositStatus {
  CONFIRMED
  FINALIZED
}

// Real gap found by forensic audit: no append-only accounting trail existed anywhere. Every
// money-affecting write (Deposit, Position.costUsd/realizedPnlUsd, PositionExit.proceedsUsd,
// TradingCashAllocation) happened independently with nothing to reconcile against if a balance
// ever looked wrong. LedgerEntry does not replace those fields as the source of truth for CURRENT
// state (TradingCashAllocation is still resynced from real on-chain balance -- that discipline,
// verified correct by audit, stays as-is); it is the audit trail: an immutable, append-only record
// of every real-money event, written atomically alongside the state change it documents. Entries
// are created only, never updated or deleted -- that discipline is enforced at the application
// layer (no .update()/.delete() call should ever target this model).
enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  BUY_SPEND
  SELL_PROCEEDS
  NETWORK_FEE
  PLATFORM_FEE
  ADJUSTMENT
  REVERSAL
}

model LedgerEntry {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  type            LedgerEntryType
  // Integer micro-USD (1_000_000 = $1.00), not Float -- Prisma's MongoDB connector does not support
  // the `Decimal` scalar (verified: hard error from `prisma generate`), so BigInt micro-units is the
  // spec's other approved authoritative-money representation, applied here from the start since this
  // model has zero existing consumers to risk. Positive = money entering the user's trading cash
  // (deposit, sell proceeds); negative = leaving it (buy spend, fees, withdrawal). USD-only for now
  // (this platform's real-money execution is USDC-denominated) -- never fabricated from a price this
  // code doesn't actually have.
  amountUsdMicros BigInt
  chain           Chain
  asset           String
  // Points at the authoritative record this entry documents (Deposit, Order, PositionExit, ...) --
  // never the entry's own reason for existing without something concrete backing it.
  referenceType   String
  referenceId     String          @db.ObjectId
  note            String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

// Exact on-chain wallet balances. Raw integer amounts are authoritative; display conversion is
// performed only at the API/UI boundary so large token quantities never lose precision in Mongo.
model WalletAssetBalance {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  walletId     String   @db.ObjectId
  userId       String   @db.ObjectId
  chain        Chain
  assetMint    String
  symbol       String?
  decimals     Int
  rawBalance   String
  supported    Boolean  @default(false)
  source       String
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([walletId, assetMint])
  @@index([userId, chain])
}

// A positive, externally-originated on-chain delta for one asset. The compound unique key and
// idempotencyKey make retries, overlapping worker cycles and restarts unable to credit/notify the
// same transfer twice. TradingCashAllocation is reconciled from the full current USDC balance,
// never incremented from this event, which prevents event + polling double-credit.
model Deposit {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey  String        @unique
  userId          String        @db.ObjectId
  walletId        String        @db.ObjectId
  chain           Chain
  walletAddress   String
  txHash          String
  slot            BigInt?
  blockTime       DateTime?
  assetMint       String
  symbol          String?
  decimals        Int
  amountRaw       String
  supported       Boolean       @default(false)
  status          DepositStatus @default(CONFIRMED)
  confirmations   Int           @default(1)
  firstDetectedAt DateTime      @default(now())
  confirmedAt     DateTime      @default(now())
  finalizedAt     DateTime?
  lastCheckedAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([chain, txHash, walletAddress, assetMint])
  @@index([userId, createdAt])
  @@index([walletId, status, createdAt])
}

model WalletSyncState {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  walletId             String    @unique @db.ObjectId
  lastScannedSignature String?
  lastScannedSlot      BigInt?
  lastSuccessfulAt     DateTime?
  lastError            String?
  lastErrorAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  wallet               Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model GlobalTradingSettings {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String   @unique @db.ObjectId
  autoCopyEnabled         Boolean  @default(false)
  globalBrainEnabled      Boolean  @default(true)
  sizingMode              String   @default("PERCENT")
  percentBalance          Float    @default(2)
  defaultAmountUsd        Float    @default(100)
  maxAmountPerTradeUsd    Float    @default(0) // 0 = user chose no platform cap
  maxTotalExposureUsd     Float    @default(0) // 0 = user chose no platform cap
  maxConcurrentPositions  Int      @default(0) // 0 = unlimited by platform
  adaptiveChase           Boolean  @default(false) // evidence only unless user sets a chase ceiling
  capitalRecoveryEnabled  Boolean  @default(true)
  capitalRecoveryMultiple Float    @default(3)
  freshMemeMode           Boolean  @default(true)
  runnerMode              Boolean  @default(true)
  allowedChains           Chain[]  @default([SOLANA])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                      String  @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String  @unique @db.ObjectId
  pushEnabled             Boolean @default(true)
  emailEnabled            Boolean @default(true)
  traderBought            Boolean @default(true)
  tradeCopied             Boolean @default(true)
  skippedTrade            Boolean @default(true)
  profitTaken             Boolean @default(true)
  positionClosed          Boolean @default(true)
  securityAlerts          Boolean @default(true)
  platformBroadcast       Boolean @default(true)
  // Global Brain discovery notifications -- deliberately independent of trading wallets/Live
  // Trading. A user with zero wallets and auto-copy off must still be able to get these; the old
  // notifyUsers() path was gated behind autoCopyEnabled+globalBrainEnabled, contradicting that.
  // Off-by-default for the noisier/lower-severity tiers so the default experience isn't a spam
  // firehose; on-by-default for genuinely strong signals.
  discoveryNewToken       Boolean @default(false)
  discoverySmartWallet    Boolean @default(true)
  discoveryWhaleActivity  Boolean @default(true)
  discoveryHeatingUp      Boolean @default(false)
  discoveryStrong         Boolean @default(true)
  discoveryHighConviction Boolean @default(true)
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TradingCashAllocation {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  chain        Chain
  asset        String    @default("USDC")
  usdcRaw      String    @default("0")
  availableUsd Float     @default(0)
  inTradesUsd  Float     @default(0)
  lastSyncedAt DateTime?
  source       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain])
  @@index([userId])
}

model Trader {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  handle          String             @unique
  displayName     String
  xHandle         String?
  avatarUrl       String?
  bio             String?
  category        String?
  verification    VerificationStatus @default(UNVERIFIED)
  kind            TraderKind         @default(PLATFORM)
  ownerUserId     String?            @db.ObjectId
  enabled         Boolean            @default(true)
  featured        Boolean            @default(false)
  recommended     Boolean            @default(false)
  defaultSelected Boolean            @default(false)
  trackingStatus  String             @default("TRACKING")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  wallets         TraderWallet[]
  follows         UserFollow[]
  signals         Signal[]
  positions       Position[]
  owner           User?              @relation("CustomTraderOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([kind, enabled, featured])
  @@index([ownerUserId])
}

model TraderWallet {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  traderId           String    @db.ObjectId
  chain              Chain
  address            String
  verified           Boolean   @default(false)
  source             String?
  createdAt          DateTime  @default(now())
  verificationMethod String?
  evidenceNote       String?
  verifiedAt         DateTime?
  monitoringStatus   String    @default("ACTIVE")
  trader             Trader    @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([traderId])
}

model UserFollow {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  userId              String     @db.ObjectId
  traderId            String     @db.ObjectId
  mode                FollowMode @default(FOLLOW_ONLY)
  fixedAmountUsd      Float      @default(100)
  takeProfitPct       Float      @default(200)
  stopLossPct         Float?
  maxChasePct         Float      @default(0) // 0 = no user chase ceiling
  maxSlippageBps      Int        @default(1500)
  maxPositionUsd      Float      @default(0) // 0 = unlimited
  maxTotalExposureUsd Float      @default(0) // 0 = unlimited
  minLiquidityUsd     Float      @default(0)
  exitMode            String     @default("ADAPTIVE")
  copyAdditionalBuys  Boolean    @default(true)
  copyReentries       Boolean    @default(true)
  customLabel         String?
  customXHandle       String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trader              Trader     @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([userId, traderId])
  @@index([traderId, mode])
  @@index([userId, mode])
}

model SourceTransaction {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  chain         Chain
  txHash        String
  walletAddress String
  slot          BigInt?
  blockTime     DateTime?
  rawJson       Json
  createdAt     DateTime  @default(now())

  @@unique([chain, txHash, walletAddress])
}

model Signal {
  id                          String         @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey              String         @unique
  chain                       Chain
  traderId                    String         @db.ObjectId
  sourceWallet                String
  sourceTx                    String
  action                      SignalAction
  inputMint                   String
  outputMint                  String
  inputRaw                    String
  outputRaw                   String
  sourcePriceUsd              Float?
  sourcePriceMethod           String?
  sourceMarketCapUsd          Float?
  sourceTokenBalanceBeforeRaw String?
  sourceTokenBalanceAfterRaw  String?
  sourceSoldPct               Float?
  dailyMovePct                Float?
  status                      SignalStatus   @default(DETECTED)
  observedAt                  DateTime
  createdAt                   DateTime       @default(now())
  trader                      Trader         @relation(fields: [traderId], references: [id], onDelete: Cascade)
  copyDecisions               CopyDecision[]

  @@index([traderId, observedAt])
  @@index([chain, observedAt])
}

model CopyDecision {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  signalId           String   @db.ObjectId
  userId             String   @db.ObjectId
  allowed            Boolean
  action             String   @default("SKIP")
  reason             String?
  explanation        String?
  amountUsd          Float?
  sourcePriceUsd     Float?
  executablePriceUsd Float?
  walletChasePct     Float?
  confidence         Int?
  createdAt          DateTime @default(now())
  signal             Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]

  @@unique([signalId, userId])
  @@index([userId, createdAt])
}

model Order {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey    String        @unique
  decisionId        String        @db.ObjectId
  userId            String        @db.ObjectId
  chain             Chain
  mode              ExecutionMode
  side              SignalAction
  inputMint         String
  outputMint        String
  requestedInputRaw String
  expectedOutputRaw String?
  minOutputRaw      String?
  actualInputRaw    String?
  actualOutputRaw   String?
  txHash            String?
  venue             String?
  feeUsd            Float?
  status            OrderStatus   @default(QUOTED)
  errorCode         String?
  quoteJson         Json?
  submittedAt       DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  decision          CopyDecision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chain, txHash])
  @@index([userId, createdAt])
}

model Position {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  userId            String         @db.ObjectId
  sourceTraderId    String         @db.ObjectId
  chain             Chain
  mode              ExecutionMode  @default(SIMULATION)
  mint              String
  quoteMint         String
  // Deliberately NOT @unique in the schema: Prisma's MongoDB connector does not make a bare
  // @unique on a nullable field sparse (verified empirically — two null values collided under a
  // plain unique index). The real uniqueness guarantee is a hand-created sparse index; see
  // packages/db/scripts/ensure-indexes.mjs. Declaring it here too would fight `prisma db push`,
  // which does not understand sparse indexes and would keep trying to "fix" it to non-sparse.
  entryTxHash       String?
  entryInputRaw     String
  entryTokenRaw     String
  remainingTokenRaw String
  // M-30 attempted fix: Prisma's MongoDB connector does NOT support the `Decimal` scalar at all
  // (verified: `prisma generate` hard-errors "The current connector does not support the Decimal
  // type" on every field it was tried on here) -- a genuine external tooling limitation, not
  // something fixable in this codebase. Left as Float for these fields; see LedgerEntry.amountUsdMicros
  // for the BigInt-micro-USD pattern (the master spec's other approved option) applied to the new
  // ledger. Migrating Position/PositionExit/TradingCashAllocation to the same pattern is real,
  // scoped, remaining work -- tracked in FORENSIC_AUDIT_FINAL.md, not done in this pass because it
  // touches ~14 files of live real-money execution code with no way to verify against a running
  // database/frontend from this environment, and deserves more care than a single blind pass.
  costUsd           Float
  avgEntryPriceUsd  Float?
  currentPriceUsd   Float?
  peakPriceUsd      Float?
  realizedPnlUsd    Float          @default(0)
  unrealizedPnlUsd  Float          @default(0)
  profitTakenUsd    Float          @default(0)
  takeProfitPct     Float
  stopLossPct       Float?
  status            PositionStatus @default(OPEN)
  openedAt          DateTime       @default(now())
  lastMarkedAt      DateTime?
  closedAt          DateTime?
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTrader      Trader         @relation(fields: [sourceTraderId], references: [id], onDelete: Restrict)
  exits             PositionExit[]

  @@index([userId, status])
  @@index([mint, status])
  @@index([sourceTraderId, openedAt])
}

model PositionExit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  positionId  String   @db.ObjectId
  reason      String
  tokenRaw    String
  proceedsUsd Float?
  pnlUsd      Float?
  txHash      String?
  createdAt   DateTime @default(now())
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model UserActivityEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  title     String
  body      String?
  status    String?
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PnLSnapshot {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  accountValueUsd  Float
  realizedPnlUsd   Float
  unrealizedPnlUsd Float
  netPnlUsd        Float
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Notification {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  deliveryKey String    @unique
  type        String
  title       String
  body        String
  data        Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LinkedSocialAccount {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  provider        String
  providerUserId  String
  username        String?
  displayName     String?
  avatarUrl       String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model OAuthState {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  provider    String
  stateHash   String   @unique
  verifierEnc String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, provider, expiresAt])
}

model UserSocialFollow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String   @db.ObjectId
  followingId String   @db.ObjectId
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  actor     String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model AppConfig {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  key            String   @unique
  valueJson      Json?
  encryptedValue String?
  isSecret       Boolean  @default(false)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Non-secret masked hints for secret fields, e.g. {"jupiterApiKey":"****7F2A"}. Never full values.
  secretHints    Json?
  // Last real provider-test outcome per sub-provider, e.g. {"jupiter":{"ok":true,"httpStatus":200,"latencyMs":132,"checkedAt":"...","message":"..."}}.
  testResults    Json?
  // True from the moment a restart-required key is saved until an admin explicitly acknowledges

enum CandidateStage {
  DISCOVERED
  ANALYZING
  PAPER_TRACKING
  PROVEN
  REJECTED
  PAUSED
}

model SmartWalletCandidate {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  // Real gap found by forensic audit (M-12/M-13/PC-D): there was no way for admin to WATCH a wallet
  // at all, distinct from the auto-pipeline's PROVEN/PAPER_TRACKING/REJECTED `stage`. A separate
  // boolean (not a `stage` value) so admin watch/unwatch never fights with or gets silently
  // overwritten by the objective scoring-worker pipeline -- "WATCH != PROVEN" holds structurally,
  // not just by convention. Continuous monitoring of a watched wallet requires no open browser tab:
  // it rides the same chainFlowObservation stream flow-worker/evm-flow-worker already write to
  // unconditionally (see brain-worker's checkWatchlist()), so detection continues as long as the
  // ingestion workers are running, independent of any admin session.
  adminWatched       Boolean        @default(false)
  adminWatchedAt     DateTime?
  chain              Chain
  address            String
  stage              CandidateStage @default(DISCOVERED)
  source             String
  sourceToken        String?
  label              String?
  traderId           String?        @db.ObjectId
  sourceQualityScore Float          @default(50)
  copyabilityScore   Float          @default(0)
  riskScore          Float          @default(50)
  consistencyScore   Float          @default(0)
  entryQualityScore  Float          @default(0)
  sampleTrades       Int            @default(0)
  profitableTrades   Int            @default(0)
  realizedPnlUsd     Float          @default(0)
  totalPnlUsd        Float          @default(0)
  volumeUsd          Float          @default(0)
  // Real gap found by forensic audit: only a single 30d window was ever fetched anywhere
  // (realizedPnlUsd/totalPnlUsd/volumeUsd above ARE that 30d window) -- the master spec explicitly
  // calls for 7D and 30D as separate, independently-visible dimensions (a wallet cooling off in the
  // last week but still showing a strong 30d number, or vice versa, is real and different evidence).
  // Additive: does not change what feeds scoreWallet/shouldProve, which stay tied to the 30d window
  // already proven correct -- these are extra, honestly-labeled evidence for the admin desk.
  realizedPnl7dUsd   Float?
  winRate7dPct       Float?
  sampleTrades7d     Int?
  averageWinnerPct   Float?
  averageLoserPct    Float?
  averageChasePct    Float?
  rugExposurePct     Float?
  insiderRiskPct     Float?
  lastScoredAt       DateTime?
  paperStartedAt     DateTime?
  provenAt           DateTime?
  rejectedReason     String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([chain, address])
  @@index([stage, copyabilityScore])
  @@index([source, createdAt])
  @@index([adminWatched])
}

// Real gap found by forensic audit (M-12/PC-D): "Admin alerts: Wallet x entered TOKEN" had nowhere
// to live -- AuditLog is for ADMIN actions (who did what), RiskIncident is scoped to trading-risk
// severity/position context, neither fits a system-generated "here's what a watched wallet just
// did" notice. A small, dedicated model instead of forcing this into either.
model AdminAlert {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  type          String

model GlobalBrainOpportunity {
  id                        String    @id @default(auto()) @map("_id") @db.ObjectId
  chain                     Chain
  mint                      String
  symbol                    String?
  name                      String?
  state                     String    @default("WATCHING")
  score                     Float     @default(0)
  action                    String    @default("WATCH")
  marketCapUsd              Float?
  liquidityUsd              Float?
  inflow10sUsd              Float     @default(0)
  inflow60sUsd              Float     @default(0)
  buyers10s                 Int       @default(0)
  buyers60s                 Int       @default(0)
  whaleBuyers60s            Int       @default(0)
  knownWhaleBuyers60s       Int       @default(0)
  smartMoneyNetFlow5mUsd    Float?
  volumeAcceleration1m      Float?
  holderGrowth5mPct         Float?
  socialVelocity            Float?
  drawdownFromRecentPeakPct Float?
  survivorScore             Float?
  reasons                   Json?
  evidence                  Json?
  // The highest state a discovery notification has already been sent for. Lets brain-worker fire
  // exactly once per genuine upgrade (e.g. entering BREAKOUT_FLOW) instead of re-notifying every
  // 750ms tick a token happens to still be in that state.
  lastNotifiedState         String?
  // Real bug found by audit: maybeSignal()'s only dedup was a rolling 30s idempotency bucket, so a
  // token that stayed BUY_NOW for 5 minutes fired a genuinely new BUY Signal every 30s -- and since
  // UserFollow.copyAdditionalBuys defaults to true, the executor would not skip these, meaning a
  // real user would get repeated real buys of the SAME token every 30 seconds for as long as it
  // stayed hot. Tracks the highest state an entry signal has already fired for, same ratchet-up /
  // reset-only-on-SCANNING discipline as lastNotifiedState, so one initial entry fires per genuine
  // qualification and a real re-entry requires an actual cool-down and re-heat, not clock rollover.
  lastSignaledState         String?
  // The observedAt of the actual MemeMarketSnapshot this score was computed from -- distinct from
  // lastEvaluatedAt, which only proves the Brain loop ran, not that it had fresh chain data to
  // work with. Lets the UI show real evidence age instead of implying every score is live.
  evidenceObservedAt        DateTime?
  firstSeenAt               DateTime  @default(now())
  lastEvaluatedAt           DateTime  @default(now())
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([chain, mint])
  @@index([action, score, lastEvaluatedAt])
  @@index([chain, lastEvaluatedAt])
}

// status:"OK" means observedAt genuinely landed within tolerance of targetAt (see delayMs);
// status:"MISSING" means the horizon passed but no sufficiently fresh price ever arrived within
// tolerance, so this row exists (and is never retried) purely to record that honestly, with every
// price/return field left null rather than silently backfilled from a stale, out-of-tolerance
// price. A 60s horizon must never silently use a price observed 8 minutes later.
model BrainOutcomeSample {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  opportunityId    String   @db.ObjectId
  chain            Chain
  mint             String
  horizonSeconds   Int
  status           String   @default("OK")
  targetAt         DateTime?
  delayMs          Int?
  priceSource      String?
  entryPriceUsd    Float?
  observedPriceUsd Float?
  returnPct        Float?
  maxRunPct        Float?
  maxDrawdownPct   Float?
  evidence         Json?
  observedAt       DateTime
  createdAt        DateTime @default(now())

  @@unique([opportunityId, horizonSeconds])
  @@index([chain, mint, observedAt])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Chain {
  SOLANA
  BASE
  ETHEREUM
  BNB
  ARBITRUM
  AVALANCHE
}

enum VerificationStatus {
  VERIFIED
  COMMUNITY_VERIFIED
  UNVERIFIED
}

enum FollowMode {
  AUTO_COPY
  WATCH_ONLY
  PAUSED
}

enum SignalAction {
  BUY
  SELL
}

enum SignalStatus {
  DETECTED
  VALIDATING
  APPROVED
  SKIPPED
  EXECUTING
  COMPLETED
  FAILED
}

enum OrderStatus {
  QUOTED
  SIGNING
  SUBMITTED
  CONFIRMING
  CONFIRMED
  FAILED
}

enum PositionStatus {
  OPEN
  PARTIALLY_CLOSED
  CLOSED
  FAILED
}

enum ExecutionMode {
  SIMULATION
  LIVE
}

model User {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  displayName       String?
  wallets           Wallet[]
  follows           UserFollow[]
  positions         Position[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  cashAllocations   TradingCashAllocation[]
}

model Wallet {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  chain            Chain
  address          String
  label            String?
  isPrimary        Boolean   @default(false)
  tradingEnabled   Boolean   @default(false)
  permissionRef    String?
  permissionExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
}

// Per-chain USDC (Trading Cash) allocation. The on-chain integer amount is the
// source of truth; the USD figures are derived for the unified consumer balance.
model TradingCashAllocation {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  chain        Chain
  usdcRaw      String   @default("0") // integer string, USDC has 6 decimals
  availableUsd Float    @default(0)
  inTradesUsd  Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chain])
  @@index([userId])
}

model Trader {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  handle       String             @unique
  displayName  String
  avatarUrl    String?
  bio          String?
  verification VerificationStatus @default(UNVERIFIED)
  enabled      Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  wallets      TraderWallet[]
  follows      UserFollow[]
  signals      Signal[]
}

model TraderWallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  traderId  String   @db.ObjectId
  chain     Chain
  address   String
  verified  Boolean  @default(false)
  source    String?
  createdAt DateTime @default(now())
  trader    Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([traderId])
}

model UserFollow {
  id                  String     @id @default(auto()) @map("_id") @db.ObjectId
  userId              String     @db.ObjectId
  traderId            String     @db.ObjectId
  mode                FollowMode @default(WATCH_ONLY)
  fixedAmountUsd      Float
  takeProfitPct       Float
  stopLossPct         Float?
  maxChasePct         Float
  maxSlippageBps      Int
  maxPositionUsd      Float
  maxTotalExposureUsd Float
  minLiquidityUsd     Float
  exitMode            String     @default("HYBRID")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trader              Trader     @relation(fields: [traderId], references: [id], onDelete: Cascade)

  @@unique([userId, traderId])
  @@index([traderId, mode])
}

model SourceTransaction {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  chain         Chain
  txHash        String
  walletAddress String
  slot          BigInt?
  blockTime     DateTime?
  rawJson       Json
  createdAt     DateTime  @default(now())

  @@unique([chain, txHash, walletAddress])
}

model Signal {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey     String         @unique
  chain              Chain
  traderId           String         @db.ObjectId
  sourceWallet       String
  sourceTx           String
  action             SignalAction
  inputMint          String
  outputMint         String
  inputRaw           String
  outputRaw          String
  sourcePriceUsd     Float?
  sourceMarketCapUsd Float?
  status             SignalStatus   @default(DETECTED)
  observedAt         DateTime
  createdAt          DateTime       @default(now())
  trader             Trader         @relation(fields: [traderId], references: [id], onDelete: Cascade)
  copyDecisions      CopyDecision[]

  @@index([traderId, observedAt])
}

model CopyDecision {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  signalId  String   @db.ObjectId
  userId    String   @db.ObjectId
  allowed   Boolean
  reason    String?
  amountUsd Float?
  createdAt DateTime @default(now())
  signal    Signal   @relation(fields: [signalId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@unique([signalId, userId])
  @@index([userId, createdAt])
}

model Order {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  decisionId        String        @db.ObjectId
  userId            String        @db.ObjectId
  chain             Chain
  mode              ExecutionMode
  side              SignalAction
  inputMint         String
  outputMint        String
  requestedInputRaw String
  expectedOutputRaw String?
  minOutputRaw      String?
  actualInputRaw    String?
  actualOutputRaw   String?
  txHash            String?
  status            OrderStatus   @default(QUOTED)
  errorCode         String?
  quoteJson         Json?
  submittedAt       DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  decision          CopyDecision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([chain, txHash])
  @@index([userId, createdAt])
}

model Position {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  userId            String         @db.ObjectId
  sourceTraderId    String         @db.ObjectId
  chain             Chain
  mint              String
  quoteMint         String
  entryTxHash       String?
  entryInputRaw     String
  entryTokenRaw     String
  remainingTokenRaw String
  costUsd           Float
  avgEntryPriceUsd  Float?
  realizedPnlUsd    Float          @default(0)
  takeProfitPct     Float
  stopLossPct       Float?
  status            PositionStatus @default(OPEN)
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exits             PositionExit[]

  @@index([userId, status])
  @@index([mint, status])
}

model PositionExit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  positionId  String   @db.ObjectId
  reason      String
  tokenRaw    String
  proceedsUsd Float?
  pnlUsd      Float?
  txHash      String?
  createdAt   DateTime @default(now())
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  actor     String
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AppConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  valueJson Json
  isSecret  Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Broadcast {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  body        String
  channel     String
  audience    String
  status      String    @default("DRAFT")
  createdBy   String?
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?  @db.ObjectId
  toEmail    String
  subject    String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
}

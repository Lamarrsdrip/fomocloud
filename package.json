{
  "name": "fomocloud",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @fomocloud/db prisma generate",
    "db:push": "pnpm --filter @fomocloud/db prisma db push",
    "db:deploy": "pnpm --filter @fomocloud/db prisma db push --skip-generate"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "bufferutil",
      "utf-8-validate",
      "msgpackr-extract"
    ]
  }
}

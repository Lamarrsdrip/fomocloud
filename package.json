{
  "name": "memecloud",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "hostinger:build": "pnpm --filter @memecloud/web build",
    "db:generate": "pnpm --filter @memecloud/db prisma generate",
    "db:push": "pnpm --filter @memecloud/db prisma db push",
    "db:seed": "pnpm --filter @memecloud/db seed",
    "db:migrate:v05": "pnpm --filter @memecloud/db migrate:v05"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.23",
      "viem>ws": "8.21.3",
      "@coinbase/cdp-sdk>axios": "1.18.0",
      "jayson>uuid": "11.1.1",
      "uuid": "11.1.1",
      "@prisma/config>deepmerge-ts": "8.0.0",
      "image-size": "2.0.2",
      "decode-uri-component": "0.5.0",
      "express>qs": "6.16.0"
    },
    "patchedDependencies": {
      "image-size@2.0.2": "patches/image-size@2.0.2.patch"
    }
  }
}
